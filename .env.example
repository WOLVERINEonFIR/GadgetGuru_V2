# ============================================================
# GadgetGuru V2 — Environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ---------- Backend (FastAPI) ----------
# Supabase Postgres connection string (Session pooler recommended)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Frontend (Vite) ----------
# Where the frontend sends API requests
VITE_API_URL=http://127.0.0.1:8000
